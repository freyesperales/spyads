# --- core ---------------------------------------------------------------

# Admin password for the /admin lead list. CHANGE THIS.
ADMIN_PASSWORD=changeme

# Path to the SQLite file. Defaults to ./data/spyads.db.
DATABASE_PATH=./data/spyads.db

# Public site URL — used in CSV exports, canonical links, and email
# report links. In dev: http://localhost:3000. In prod: your real URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- scrapers -----------------------------------------------------------

# Optional Meta Graph API token. When set, the Meta scraper uses the
# official API instead of public web scraping (more reliable, better
# data, no anti-bot risk).
# META_ACCESS_TOKEN=

# Set to 1 to bypass real scrapers and emit synthetic ads — used in CI,
# during landing-page work, and on hosts without Chromium installed.
# Comment out (or set to 0) to scrape Meta + Google for real.
# SPYADS_USE_STUBS=1

# --- email (Resend) ----------------------------------------------------

# Resend API key — sign up free at https://resend.com (3000/mo free).
# When unset, emails are skipped silently and only logged. The on-screen
# report still works perfectly — the email is a bonus delivery.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# Sender address. Must use a domain you've verified in Resend.
# Example: "spyads <reports@your-domain.com>"
# EMAIL_FROM=
